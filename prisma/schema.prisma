// =============================================================================
// Prisma Schema — Farmácia Bairro Saúde
// Banco: MySQL  |  ORM: Prisma
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// =============================================================================
// Enums
// =============================================================================

enum TipoPerfil {
  GERENTE
  ATENDENTE
  FARMACEUTICO
  CAIXA
}

enum StatusVenda {
  EM_ANDAMENTO
  EM_AVALIACAO
  AGUARDANDO_PAGAMENTO
  FINALIZADA
  CANCELADA
}

enum Classificacao {
  LIVRE
  CONTROLADO
  PRESCRITO
}

// =============================================================================
// Models
// =============================================================================

/// Usuário do sistema — perfil único (Gerente, Atendente, Caixa ou Farmacêutico).
/// O campo `numeroCRF` é preenchido apenas quando perfil == FARMACEUTICO.
model Usuario {
  id        Int        @id @default(autoincrement())
  nome      String     @db.VarChar(150)
  email     String     @unique @db.VarChar(200)
  senha     String     @db.VarChar(255)
  ehAtivo   Boolean    @default(true)
  perfil    TipoPerfil
  numeroCRF String?    @db.VarChar(20)

  // Relações
  vendasComoAtendente Venda[]       @relation("VendaAtendente")
  vendasComoCaixa     Venda[]       @relation("VendaCaixa")
  notificacoes        Notificacao[]

  @@map("usuarios")
}

/// Produto cadastrado na farmácia.
/// O campo `quantidadeEstoque` faz o papel do controle de estoque
/// (decisão: sem tabela Estoque separada — ver justificativa no walkthrough).
model Produto {
  id                  Int           @id @default(autoincrement())
  nome                String        @db.VarChar(200)
  codigoBarras        String        @unique @db.VarChar(50)
  descricao           String?       @db.Text
  principioAtivo      String        @db.VarChar(200)
  concentracao        String?       @db.VarChar(50)
  formulaFarmaceutica String?       @db.VarChar(100)
  fabricante          String        @db.VarChar(200)
  numeroRegAnvisa     String?       @db.VarChar(30)
  tarja               String?       @db.VarChar(30)
  categoria           String?       @db.VarChar(80)
  classificacao       Classificacao @default(LIVRE)
  quantidadeEstoque   Int           @default(0)
  localEstoque        String?       @db.VarChar(100)
  validade            DateTime?
  classeControle      String?       @db.VarChar(30)
  retencaoReceita     Boolean       @default(false)
  validadeReceita     Int?          // Em dias
  generico            Boolean       @default(false)
  lote                String?       @db.VarChar(50)
  preco               Decimal       @db.Decimal(10, 2)
  dataFabricacao      DateTime?
  quantidadeMaxima    Int?          // Qtd máxima permitida por receita

  // Relações
  itensVenda ItemVenda[]

  @@map("produtos")
}

/// Venda realizada na farmácia.
/// `atendenteId` é obrigatório (quem iniciou), `caixaId` é preenchido
/// somente ao confirmar pagamento.
model Venda {
  id       Int         @id @default(autoincrement())
  dataHora DateTime    @default(now())
  status   StatusVenda @default(EM_ANDAMENTO)

  atendenteId Int
  atendente   Usuario @relation("VendaAtendente", fields: [atendenteId], references: [id])

  caixaId Int?
  caixa   Usuario? @relation("VendaCaixa", fields: [caixaId], references: [id])

  // Relações
  itens        ItemVenda[]
  prescricoes  Prescricao[]
  notificacoes Notificacao[]

  @@map("vendas")
}

/// Item individual dentro de uma Venda.
/// `aprovadoFarmaceutico` indica se o farmacêutico já validou este item
/// (relevante para produtos controlados/prescritos).
model ItemVenda {
  id                   Int     @id @default(autoincrement())
  quantidade           Int
  aprovadoFarmaceutico Boolean @default(false)

  vendaId   Int
  venda     Venda   @relation(fields: [vendaId], references: [id])

  produtoId Int
  produto   Produto @relation(fields: [produtoId], references: [id])

  @@map("itens_venda")
}

/// Prescrição / receita médica vinculada a uma Venda.
/// Uma venda pode ter 0 ou mais prescrições (ex: venda com dois
/// controlados de receitas distintas).
model Prescricao {
  id                Int      @id @default(autoincrement())
  numeroPrescricao  String   @db.VarChar(50)
  nomeMedico        String   @db.VarChar(200)
  numeroCrm         String   @db.VarChar(20)
  ufCrm             String   @db.Char(2)
  nomePaciente      String   @db.VarChar(200)
  retencao          Boolean  @default(false)
  dataEmissao       DateTime
  dataValidade      DateTime
  anexo             String?  @db.VarChar(500) // Caminho/URL do arquivo digitalizado
  retida            Boolean  @default(false)
  quantidadeMaxima  Int?

  vendaId Int
  venda   Venda @relation(fields: [vendaId], references: [id])

  @@map("prescricoes")
}

/// Notificação interna enviada ao farmacêutico (ex: prescrição pendente).
/// `vendaId` é opcional — indica a venda que originou a notificação.
model Notificacao {
  id       Int      @id @default(autoincrement())
  mensagem String   @db.Text
  dataHora DateTime @default(now())
  lida     Boolean  @default(false)

  farmaceuticoId Int
  farmaceutico   Usuario @relation(fields: [farmaceuticoId], references: [id])

  vendaId Int?
  venda   Venda? @relation(fields: [vendaId], references: [id])

  @@map("notificacoes")
}
